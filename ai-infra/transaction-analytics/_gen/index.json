    {
      "rel": "Architecture/Invariants.md",
      "path": "transaction-analytics/Architecture/Invariants.md",
      "name": "Invariants",
      "type": "architecture",
      "summary": "Seven unbreakable rules of the project — the constitution. A violation means stop and rework.",
      "rev": "9b00294467a9",
      "headings": [
        {
          "n": 1,
          "level": 2,
          "text": "1. Money is always integers in minor units, never float",
          "line": 11,
          "endLine": 16
        },
        {
          "n": 2,
          "level": 2,
          "text": "2. Dates are UTC in the DB",
          "line": 17,
          "endLine": 20
        },
        {
          "n": 3,
          "level": 2,
          "text": "3. The core does not know about the source",
          "line": 21,
          "endLine": 24
        },
        {
          "n": 4,
          "level": 2,
          "text": "4. Dedup and multi-tenancy",
          "line": 25,
          "endLine": 29
        },
        {
          "n": 5,
          "level": 2,
          "text": "5. Matching is a separate post-processing stage",
          "line": 30,
          "endLine": 34
        },
        {
          "n": 6,
          "level": 2,
          "text": "6. Side effects — only through events",
          "line": 35,
          "endLine": 39
        },
        {
          "n": 7,
          "level": 2,
          "text": "7. Secrets — env/secrets only",
          "line": 40,
          "endLine": 51
        },
        {
          "n": 8,
          "level": 3,
          "text": "Consequences",
          "line": 45,
          "endLine": 51
