#!/bin/sh
# Vault-sync guard. All logic now lives in Node (tools/vault/lib/rules.mjs).
#
# Why nothing is done in sh anymore: paths here contain Cyrillic, spaces and `↔`
# (git C-quotes them without -z), and GNU grep 3.0 in this Git Bash errors on
# bracket patterns like '\[\['. Both of the original rules are reimplemented as
# `legacy-code-without-vault` and `legacy-index-status`, so behaviour is a strict
# superset of what this file used to do.
#
# `check` opens no file for writing, so the hook can never dirty the tree it is
# validating. NEVER call `build` from here.
#
# Escape hatch (justify it in the commit message):  SKIP_VAULT_CHECK=1 git commit ...

[ "$SKIP_VAULT_CHECK" = "1" ] && exit 0

exec node tools/vault/v.mjs check --staged
