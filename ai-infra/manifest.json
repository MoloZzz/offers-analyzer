{
  "schemaVersion": 1,
  "name": "portable-ai-infra",
  "version": "0.1.0",
  "description": "Copy-and-own project memory, context-control, and governance starter kit.",
  "runtime": {
    "node": ">=20"
  },
  "distribution": {
    "mode": "copy-and-own",
    "updates": "manual-review"
  },
  "entrypoints": {
    "cli": "bin/ai-infra.mjs",
    "engine": "engine/v.mjs"
  },
  "profiles": {
    "core": {
      "description": "Curated vault, context zone, null adapter, and manual retrieval protocol.",
      "enabledByDefault": true
    }
  },
  "templates": {
    "vault": "templates/vault",
    "specs": "templates/specs",
    "policy": "templates/policy",
    "configuration": "templates/vault.config.json.template"
  },
  "optionalIntegrations": [
    "agent-runtime-snippets",
    "ci-workflow",
    "local-hook",
    "project-source-adapter",
    "advisory-evidence"
  ],
  "safety": {
    "dryRunWrites": false,
    "checkWrites": false,
    "defaultAdapter": "none",
    "automaticNetworkAccess": false,
    "automaticProductionActions": false
  }
}
